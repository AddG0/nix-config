# Behavioural tests for codeq against small fixture projects: ./codeq.bats. The
# fixtures are no git repos, so these also cover the `find` fallback in source_files.
{
  harness,
  pkgs,
  self,
  ...
}: let
  codeq = pkgs.callPackage ../package.nix {
    customPkgs = self.legacyPackages.${pkgs.stdenv.hostPlatform.system};
  };

  # One deeply branching function and one block pasted twice.
  pythonFixture = pkgs.writeTextDir "proj/app/logic.py" ''
    def classify(a, b, c, d, e, f):
        if a and b:
            return 1
        elif a or c:
            return 2
        elif d and (e or f):
            return 3
        elif b and not c:
            return 4
        elif e:
            return 5
        elif f and a:
            return 6
        elif c and d:
            return 7
        elif not a and not b:
            return 8
        elif a and f:
            return 9
        elif d or e:
            return 10
        return 0


    def first(rows):
        total = 0
        for row in rows:
            if row.get("amount") is not None and row.get("currency") == "USD":
                total += row["amount"] * 100 // 3 + row.get("fee", 0) - row.get("discount", 0)
        return total


    def second(rows):
        total = 0
        for row in rows:
            if row.get("amount") is not None and row.get("currency") == "USD":
                total += row["amount"] * 100 // 3 + row.get("fee", 0) - row.get("discount", 0)
        return total
  '';

  # The same pasted block as logic.py, but generated: it must never be measured.
  generatedFixture = pkgs.writeTextDir "proj/app/client_pb.py" ''
    # Copyright header long enough to push the marker below line five,
    # the way a license-header hook does.
    #
    #
    #
    #
    # @generated by protoc-gen-python. DO NOT EDIT.
    def first(rows):
        total = 0
        for row in rows:
            if row.get("amount") is not None and row.get("currency") == "USD":
                total += row["amount"] * 100 // 3 + row.get("fee", 0) - row.get("discount", 0)
        return total
  '';

  # app depends on core, never the reverse: core should come out stable.
  javaCore = pkgs.writeTextDir "src/main/java/com/example/core/Money.java" ''
    package com.example.core;
    public record Money(long cents) {}
  '';
  javaApp = pkgs.writeTextDir "src/main/java/com/example/app/Checkout.java" ''
    package com.example.app;
    import com.example.core.Money;
    public class Checkout {
      public Money total(long a, long b) { return new Money(a + b); }
    }
  '';
  javaFixture = pkgs.symlinkJoin {
    name = "codeq-java-fixture";
    paths = [javaCore javaApp];
  };
in
  harness.bats "codeq-tests" [./codeq.bats] {
    nativeBuildInputs = [codeq pkgs.jdk pkgs.zsh pkgs.nushell];
    codeqShare = "${codeq}/share";
    inherit pythonFixture generatedFixture javaFixture;
  }
