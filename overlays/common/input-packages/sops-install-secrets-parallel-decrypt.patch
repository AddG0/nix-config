+// sourceKey identifies one decryption. Format is part of the key because it is a
+// per-secret option: two secrets may name the same file with different formats,
+// and they must not share a decrypted result.
+type sourceKey struct {
+	file   string
+	format FormatType
+}
+
 func decryptSecrets(secrets []secret) error {
+	// Decrypt each distinct source exactly once, concurrently. decrypt.File
+	// reaches out to a remote KMS whenever one is a recipient, so these calls are
+	// network-bound and running them serially dominated activation time.
+	// Deduplicating also matters on its own: the sourceFiles cache below never
+	// hits for keyed secrets (it fills only one of data/binary, leaving the guard
+	// true), so this used to be one round trip per secret rather than per file.
+	sources := make(map[sourceKey]struct{})
+	for i := range secrets {
+		sources[sourceKey{secrets[i].SopsFile, secrets[i].Format}] = struct{}{}
+	}
+
+	var (
+		mu       sync.Mutex
+		wg       sync.WaitGroup
+		firstErr error
+	)
+	plains := make(map[sourceKey][]byte, len(sources))
+	sem := make(chan struct{}, 8)
+
+	for src := range sources {
+		wg.Add(1)
+		go func(src sourceKey) {
+			defer wg.Done()
+			sem <- struct{}{}
+			defer func() { <-sem }()
+
+			plain, err := decrypt.File(src.file, string(src.format))
+
+			mu.Lock()
+			defer mu.Unlock()
+			if err != nil {
+				if firstErr == nil {
+					firstErr = fmt.Errorf("failed to decrypt '%s': %w", src.file, err)
+				}
+				return
+			}
+			plains[src] = plain
+		}(src)
+	}
+	wg.Wait()
+	if firstErr != nil {
+		return firstErr
+	}
+
 	sourceFiles := make(map[string]plainData)
 	for i := range secrets {
-		if err := decryptSecret(&secrets[i], sourceFiles); err != nil {
+		if err := decryptSecret(&secrets[i], sourceFiles, plains); err != nil {
 			return err
 		}
 	}
