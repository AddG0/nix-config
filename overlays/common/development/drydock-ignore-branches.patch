+    #[tokio::test]
+    async fn ignored_branches_stay_listed_but_never_count_as_unpushed() {
+        let dir = tempfile::tempdir().unwrap();
+        let upstream = dir.path().join("upstream.git");
+        let work = dir.path().join("work");
+        std::fs::create_dir_all(&work).unwrap();
+        git(dir.path(), &["init", "-q", "--bare", "upstream.git"]);
+        git(&work, &["init", "-q", "-b", "main", "."]);
+        git(&work, &["remote", "add", "origin", upstream.to_str().unwrap()]);
+        git(&work, &["commit", "-qm", "init", "--allow-empty"]);
+        for branch in ["nightly", "feature"] {
+            git(&work, &["branch", branch]);
+            git(&work, &["push", "-q", "-u", "origin", branch]);
+            git(&work, &["checkout", "-q", branch]);
+            git(&work, &["commit", "-qm", "local only", "--allow-empty"]);
+        }
+        git(&work, &["checkout", "-q", "nightly"]);
+
