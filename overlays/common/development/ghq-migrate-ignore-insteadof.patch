+// getGitConfiguredRemoteURL reads remote.<name>.url as configured, before any
+// insteadOf rewriting. --get-all's first line matches what `git remote get-url`
+// reports for a multi-URL remote, where plain --get would report the last.
+func getGitConfiguredRemoteURL(dir, remote string) (string, error) {
+	cmd := exec.Command("git", "config", "--local", "--get-all", "remote."+remote+".url")
+	cmd.Dir = dir
+	// Legacy GIT_CONFIG aims `git config` at one file and conflicts with
+	// --local, so it would hide the very remotes being asked about.
+	cmd.Env = envWithout(os.Environ(), "GIT_CONFIG")
+	out, err := cmd.Output()
+	if err != nil {
+		return "", err
+	}
+	first, _, _ := strings.Cut(strings.TrimSpace(string(out)), "\n")
+	return strings.TrimSpace(first), nil
+}
+
+func envWithout(env []string, key string) []string {
+	prefix := key + "="
+	kept := make([]string, 0, len(env))
+	for _, kv := range env {
+		if !strings.HasPrefix(kv, prefix) {
+			kept = append(kept, kv)
+		}
+	}
+	return kept
+}
