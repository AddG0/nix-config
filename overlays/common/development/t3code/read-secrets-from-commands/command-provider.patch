@@ -0,0 +1,219 @@
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeFileSystem from "@effect/platform-node/NodeFileSystem";
+import { assert, describe, it } from "@effect/vitest";
+import { SecretProviderId, type SecretReference } from "@t3tools/contracts";
+import * as SecretResolver from "@t3tools/secret-provider-core/server/SecretResolver";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Logger from "effect/Logger";
+import * as PlatformError from "effect/PlatformError";
+import * as Sink from "effect/Sink";
+import * as Stream from "effect/Stream";
+import * as TestClock from "effect/testing/TestClock";
+import { ChildProcessSpawner } from "effect/process";
+
+import { definition } from "../shared/definition.ts";
+import { driver } from "./driver.ts";
+
+const encoder = new TextEncoder();
+
+type CommandOutcome =
+  | {
+      readonly stdout?: string;
+      readonly stderr?: string;
+      readonly code?: number;
+      readonly hang?: boolean;
+    }
+  | { readonly missing: true };
+
+interface Invocation {
+  readonly command: string;
+  readonly args: ReadonlyArray<string>;
+  readonly shell: unknown;
+  readonly forceKillAfter: unknown;
+}
+
+function fakeCommands(answer: (invocation: Invocation) => CommandOutcome) {
+  const invocations: Array<Invocation> = [];
+  const spawned = Deferred.makeUnsafe<void>();
+  // The driver contract offers every driver the file system and randomness too.
+  const layer = Layer.mergeAll(
+    Layer.succeed(
+      ChildProcessSpawner.ChildProcessSpawner,
+      ChildProcessSpawner.make((command) => {
+        const {
+          command: program,
+          args,
+          options,
+        } = command as unknown as {
+          readonly command: string;
+          readonly args: ReadonlyArray<string>;
+          readonly options: { readonly shell?: unknown; readonly forceKillAfter?: unknown };
+        };
+        const invocation = {
+          command: program,
+          args,
+          shell: options.shell,
+          forceKillAfter: options.forceKillAfter,
+        };
+        invocations.push(invocation);
+        Deferred.doneUnsafe(spawned, Effect.void);
+        const outcome = answer(invocation);
+        if ("missing" in outcome) {
+          return Effect.fail(
+            PlatformError.systemError({
+              _tag: "NotFound",
+              module: "ChildProcess",
+              method: "spawn",
+            }),
+          );
+        }
+        return Effect.succeed(
+          ChildProcessSpawner.makeHandle({
+            pid: ChildProcessSpawner.ProcessId(1),
+            exitCode: outcome.hang
+              ? Effect.never
+              : Effect.succeed(ChildProcessSpawner.ExitCode(outcome.code ?? 0)),
+            isRunning: Effect.succeed(false),
+            kill: () => Effect.void,
+            unref: Effect.succeed(Effect.void),
+            stdin: Sink.drain,
+            stdout: Stream.make(encoder.encode(outcome.stdout ?? "")),
+            stderr: Stream.make(encoder.encode(outcome.stderr ?? "")),
+            all: Stream.empty,
+            getInputFd: () => Sink.drain,
+            getOutputFd: () => Stream.empty,
+          }),
+        );
+      }),
+    ),
+    NodeFileSystem.layer,
+    NodeCrypto.layer,
+  );
+  return { layer, invocations, spawned };
+}
+
+/** Each warning the driver logs, as text, so a test can say what a reader of the log would learn. */
+function capturedWarnings() {
+  const warnings: Array<string> = [];
+  const layer = Logger.layer(
+    [Logger.make(({ message }) => void warnings.push(JSON.stringify(message)))],
+    { mergeWithExisting: false },
+  );
+  return { warnings, layer };
+}
+
+describe("Command driver", () => {
+  it.effect("runs the command line as words, without a shell, and trims its output", () => {
+    const commands = fakeCommands(() => ({ stdout: "  eyJ0b2tlbiI6dHJ1ZX0\n" }));
+    return Effect.gen(function* () {
+      assert.deepStrictEqual(yield* driver.read({}, ["gh  auth token"]), ["eyJ0b2tlbiI6dHJ1ZX0"]);
+      assert.deepStrictEqual(commands.invocations, [
+        { command: "gh", args: ["auth", "token"], shell: false, forceKillAfter: "1 second" },
+      ]);
+    }).pipe(Effect.provide(commands.layer));
+  });
+
+  it.effect(
+    "reads a command that exits non-zero as undefined, logging its last stderr line",
+    () => {
+      const commands = fakeCommands(() => ({
+        code: 1,
+        stdout: "partial",
+        stderr: "checking session\nnot logged in: run gh auth login\n",
+      }));
+      const log = capturedWarnings();
+      return Effect.gen(function* () {
+        assert.deepStrictEqual(yield* driver.read({}, ["gh auth token"]), [undefined]);
+        assert.deepStrictEqual(log.warnings, [
+          JSON.stringify([
+            "Secret command failed",
+            { program: "gh", exitCode: 1, stderr: "not logged in: run gh auth login" },
+          ]),
+        ]);
+      }).pipe(Effect.provide(Layer.mergeAll(commands.layer, log.layer)));
+    },
+  );
+
+  it.effect("logs at most 200 characters of a failed command's stderr", () => {
+    const commands = fakeCommands(() => ({ code: 2, stderr: "x".repeat(500) }));
+    const log = capturedWarnings();
+    return Effect.gen(function* () {
+      yield* driver.read({}, ["gh auth token"]);
+      assert.include(log.warnings[0], `"stderr":"${"x".repeat(200)}"`);
+      assert.notInclude(log.warnings[0], "x".repeat(201));
+    }).pipe(Effect.provide(Layer.mergeAll(commands.layer, log.layer)));
+  });
+
+  it.effect("reads blank output as undefined", () => {
+    const commands = fakeCommands(() => ({ stdout: " \n\t\n" }));
+    return Effect.gen(function* () {
+      assert.deepStrictEqual(yield* driver.read({}, ["gh auth token"]), [undefined]);
+    }).pipe(Effect.provide(commands.layer));
+  });
+
+  it.effect("reads a program that cannot start as undefined, logging why it could not", () => {
+    const commands = fakeCommands(() => ({ missing: true }));
+    const log = capturedWarnings();
+    return Effect.gen(function* () {
+      assert.deepStrictEqual(yield* driver.read({}, ["no-such-program"]), [undefined]);
+      assert.deepStrictEqual(log.warnings, [
+        JSON.stringify([
+          "Could not run secret command",
+          { program: "no-such-program", error: "NotFound" },
+        ]),
+      ]);
+    }).pipe(Effect.provide(Layer.mergeAll(commands.layer, log.layer)));
+  });
+
+  it.effect("gives up on a command after ten seconds by default", () => {
+    const commands = fakeCommands(() => ({ hang: true }));
+    return Effect.gen(function* () {
+      const reading = yield* driver.read({}, ["gh auth token"]).pipe(Effect.forkChild);
+      yield* Deferred.await(commands.spawned);
+      yield* TestClock.adjust("9 seconds");
+      assert.isUndefined(reading.pollUnsafe());
+      yield* TestClock.adjust("1 second");
+
+      assert.deepStrictEqual(yield* Fiber.join(reading), [undefined]);
+    }).pipe(Effect.provide(commands.layer));
+  });
+
+  it.effect("gives up on a command at its provider's timeout", () => {
+    const commands = fakeCommands(() => ({ hang: true }));
+    return Effect.gen(function* () {
+      const reading = yield* driver
+        .read({ timeoutSeconds: 2 }, ["gh auth token"])
+        .pipe(Effect.forkChild);
+      yield* Deferred.await(commands.spawned);
+      yield* TestClock.adjust("2 seconds");
+
+      assert.deepStrictEqual(yield* Fiber.join(reading), [undefined]);
+    }).pipe(Effect.provide(commands.layer));
+  });
+
+  it.effect("runs the command again on every resolve, so an expiring token stays current", () => {
+    let issued = 0;
+    const commands = fakeCommands(() => ({ stdout: `token-${++issued}\n` }));
+    const provider = SecretProviderId.make("gateway");
+    const token: SecretReference = { provider, reference: "gh auth token" };
+    return Effect.gen(function* () {
+      const resolver = yield* SecretResolver.SecretResolver;
+
+      assert.deepStrictEqual(yield* resolver.read([token]), ["token-1"]);
+      assert.deepStrictEqual(yield* resolver.read([token]), ["token-2"]);
+      assert.strictEqual(commands.invocations.length, 2);
+    }).pipe(
+      Effect.provide(
+        SecretResolver.layer({
+          drivers: [driver],
+          secretProviders: Effect.succeed({
+            [provider]: { kind: definition.kind, label: "Gateway", config: {} },
+          }),
+        }).pipe(Layer.provide(commands.layer)),
+      ),
+    );
+  });
+});
diff --git a/packages/secret-provider-command/src/server/driver.ts b/packages/secret-provider-command/src/server/driver.ts
