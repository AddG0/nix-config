+import { describe, expect, it } from "@effect/vitest";
+import * as Schema from "effect/Schema";
+
+import { CommandSecretProviderConfig, commandWords, definition } from "./definition.ts";
+
+const isConfig = Schema.is(CommandSecretProviderConfig);
+
+describe("Command definition", () => {
+  it("accepts a command line with or without arguments", () => {
+    for (const reference of [
+      "gh auth token",
+      "/usr/local/bin/print-token",
+      "pass  show  api/key",
+    ]) {
+      expect(definition.isReference(reference), reference).toBe(true);
+    }
+  });
+
+  it("rejects a blank, multi-line, or overlong command", () => {
+    for (const reference of ["", "   ", "gh auth token\nrm -rf ~", `print ${"x".repeat(1024)}`]) {
+      expect(definition.isReference(reference), reference).toBe(false);
+    }
+  });
+
+  it("splits a command line into its program and arguments on any run of whitespace", () => {
+    expect(commandWords("  pass \t show  api/key ")).toEqual(["pass", "show", "api/key"]);
+  });
+
+  it("takes a timeout of whole seconds up to two minutes, or none", () => {
+    expect(isConfig({})).toBe(true);
+    expect(isConfig({ timeoutSeconds: 30 })).toBe(true);
+    for (const timeoutSeconds of [0, 1.5, 121]) {
+      expect(isConfig({ timeoutSeconds }), String(timeoutSeconds)).toBe(false);
+    }
+  });
+});
