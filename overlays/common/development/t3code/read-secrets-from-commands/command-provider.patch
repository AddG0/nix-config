index 00000000..f3203527
--- /dev/null
+++ b/packages/secret-provider-command/src/server/driver.ts
@@ -0,0 +1,82 @@
+import { spawnAndCollect } from "@t3tools/provider-core/server/snapshotProbe";
+import { defineSecretProviderDriver } from "@t3tools/secret-provider-core/server/driver";
+import { resolveSpawnCommand } from "@t3tools/shared/shell";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import * as PlatformError from "effect/PlatformError";
+import { ChildProcess } from "effect/process";
+
+import { commandWords, DEFAULT_COMMAND_TIMEOUT_SECONDS, definition } from "../shared/definition.ts";
+
+const FORCE_KILL_AFTER = "1 second";
+
+const runCommand = Effect.fn("CommandSecretDriver.runCommand")(function* (
+  program: string,
+  args: ReadonlyArray<string>,
+) {
+  const spawnCommand = yield* resolveSpawnCommand(program, args);
+  return yield* spawnAndCollect(
+    program,
+    // A command that ignores SIGTERM would otherwise hold the read, and the resolver, past its timeout.
+    ChildProcess.make(spawnCommand.command, spawnCommand.args, {
+      shell: spawnCommand.shell,
+      forceKillAfter: FORCE_KILL_AFTER,
+    }),
+  );
+});
+
+// Enough of stderr's last line to say why ("not logged in"), without echoing whatever else a command prints.
+const STDERR_EXCERPT = 200;
+
+const lastLine = (stderr: string) =>
+  stderr.trim().split("\n").at(-1)?.trim().slice(0, STDERR_EXCERPT) ?? "";
+
+// Logs name the program only: arguments can carry an account or a vault path.
+const readOne = Effect.fn("CommandSecretDriver.readOne")(function* (
+  reference: string,
+  timeoutSeconds: number,
+) {
+  const [program = "", ...args] = commandWords(reference);
+  const outcome = yield* runCommand(program, args).pipe(
+    Effect.timeoutOption(Duration.seconds(timeoutSeconds)),
+    Effect.result,
+  );
+  if (outcome._tag === "Failure") {
+    yield* Effect.logWarning("Could not run secret command", {
+      program,
+      error:
+        outcome.failure instanceof PlatformError.PlatformError
+          ? outcome.failure.reason._tag
+          : outcome.failure._tag,
+    });
+    return undefined;
+  }
+  if (Option.isNone(outcome.success)) {
+    yield* Effect.logWarning("Secret command did not finish in time", { program, timeoutSeconds });
+    return undefined;
+  }
+  const { code, stdout, stderr } = outcome.success.value;
+  if (code !== 0) {
+    yield* Effect.logWarning("Secret command failed", {
+      program,
+      exitCode: code,
+      stderr: lastLine(stderr),
+    });
+    return undefined;
+  }
+  // Unlike a stored secret, command output ends in a newline that is never part of the value.
+  const value = stdout.trim();
+  if (value.length === 0) {
+    yield* Effect.logWarning("Secret command printed nothing", { program });
+    return undefined;
+  }
+  return value;
+});
+
+export const driver = defineSecretProviderDriver({
+  kind: definition.kind,
+  definition,
+  read: ({ timeoutSeconds = DEFAULT_COMMAND_TIMEOUT_SECONDS }, references) =>
+    Effect.forEach(references, (reference) => readOne(reference, timeoutSeconds)),
+});
