@@ -0,0 +1,36 @@
+import { SecretProviderKind } from "@t3tools/contracts";
+import { defineSecretProvider } from "@t3tools/secret-provider-core/shared/definition";
+import * as Schema from "effect/Schema";
+
+export const DEFAULT_COMMAND_TIMEOUT_SECONDS = 10;
+// The resolver reads one provider at a time, so a hung command holds up every other uncached read.
+export const MAX_COMMAND_TIMEOUT_SECONDS = 120;
+
+export const CommandTimeoutSeconds = Schema.Int.check(
+  Schema.isBetween({ minimum: 1, maximum: MAX_COMMAND_TIMEOUT_SECONDS }),
+);
+
+export const CommandSecretProviderConfig = Schema.Struct({
+  timeoutSeconds: Schema.optionalKey(CommandTimeoutSeconds),
+});
+export type CommandSecretProviderConfig = typeof CommandSecretProviderConfig.Type;
+
+const MAX_REFERENCE_LENGTH = 1024;
+
+/** A reference is a program and its arguments, split on whitespace; no shell ever reads it. */
+export const commandWords = (reference: string): ReadonlyArray<string> =>
+  reference.trim().split(/\s+/u);
+
+export const definition = defineSecretProvider({
+  kind: SecretProviderKind.make("command"),
+  label: "Command",
+  configSchema: CommandSecretProviderConfig,
+  isReference: (reference) =>
+    reference.trim().length > 0 &&
+    reference.length <= MAX_REFERENCE_LENGTH &&
+    !/[\r\n]/u.test(reference),
+  referencePlaceholder: "gh auth token",
+  invalidReferenceMessage: "Enter a command on one line, like gh auth token.",
+  // Token helpers print short-lived values and keep their own cache against the expiry.
+  cacheable: false,
+});
