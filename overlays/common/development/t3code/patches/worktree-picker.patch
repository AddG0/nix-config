+/**
+ * What branch a not-yet-created worktree ends up on.
+ *
+ * `auto` is the unattended default: git refuses to check out a branch that is
+ * already in another worktree, and the base usually is (it is the checkout the
+ * thread was started from), so a fresh generated branch is the only safe choice.
+ */
+export type NewWorktreeBranchPlan =
+  | { kind: "auto" }
+  | { kind: "checkout" }
+  | { kind: "named"; name: string };
+
+export const AUTO_NEW_WORKTREE_BRANCH_PLAN: NewWorktreeBranchPlan = { kind: "auto" };
+
+// A branch git already has checked out anywhere cannot be checked out again.
+export function resolveNewWorktreeBranchPlan(input: {
+  ref: Pick<VcsRef, "name" | "isRemote" | "worktreePath">;
+  localBranchNames: ReadonlySet<string>;
+}): NewWorktreeBranchPlan {
+  const { ref, localBranchNames } = input;
+  if (ref.isRemote === true) {
+    const localName = deriveLocalBranchNameFromRemoteRef(ref.name);
+    return localBranchNames.has(localName)
+      ? AUTO_NEW_WORKTREE_BRANCH_PLAN
+      : { kind: "named", name: localName };
+  }
+  return ref.worktreePath ? AUTO_NEW_WORKTREE_BRANCH_PLAN : { kind: "checkout" };
+}
+
+export const WORKTREE_SELECT_VALUE_PREFIX = "worktree-path:";
+
+export interface WorktreeOption {
+  path: string;
+  branch: string;
+  label: string;
+  /** The checkout the active project points at — not necessarily the main one. */
+  isCurrent: boolean;
+}
+
+// The project's own checkout keeps the "local" value: picking it means "run
+// where this project points", which is what that env mode has always meant.
+export function worktreeOptionValue(option: WorktreeOption): string {
+  return option.isCurrent ? "local" : worktreeSelectValue(option.path);
+}
+
+export function worktreeSelectValue(worktreePath: string): string {
+  return `${WORKTREE_SELECT_VALUE_PREFIX}${worktreePath}`;
+}
+
+export function parseWorktreeSelectValue(value: string): string | null {
+  return value.startsWith(WORKTREE_SELECT_VALUE_PREFIX)
+    ? value.slice(WORKTREE_SELECT_VALUE_PREFIX.length)
+    : null;
+}
+
+// Every checkout of the repo, read off the branch listing rather than a
+// worktree-specific call: `worktreePath` is already populated per local ref and
+// git allows at most one worktree per branch, so the two lists are the same set.
+//
+// The project's own directory is one entry among the rest, never assumed to be
+// the repo's main checkout: a project can point at a linked worktree (ghq lists
+// those as siblings), which would otherwise label the main clone as a worktree
+// and the worktree as "current".
+export function resolveWorktreeOptions(input: {
+  refs: ReadonlyArray<VcsRef>;
+  activeProjectCwd: string | null;
+}): ReadonlyArray<WorktreeOption> {
+  const byPath = new Map<string, WorktreeOption>();
+  for (const ref of input.refs) {
+    const worktreePath = ref.worktreePath;
+    if (!worktreePath || ref.isRemote) {
+      continue;
+    }
+    if (byPath.has(worktreePath)) continue;
+    byPath.set(worktreePath, {
+      path: worktreePath,
+      branch: ref.name,
+      label: formatWorktreePathForDisplay(worktreePath),
+      isCurrent: worktreePath === input.activeProjectCwd,
+    });
+  }
+  // Where you already are reads first.
+  return [...byPath.values()].toSorted(
+    (left, right) => Number(right.isCurrent) - Number(left.isCurrent),
+  );
+}
+
 export function resolveCurrentWorkspaceLabel(activeWorktreePath: string | null): string {
