+
+export interface WorktreeRemovalOffer {
+  worktreePath: string;
+  projectCwd: string;
+  displayPath: string;
+}
+
+/**
+ * The worktree a thread leaves behind once it is done with, or null when there
+ * is nothing to offer: no worktree, another thread still in it, or no project
+ * to run `git worktree remove` from.
+ */
+export function resolveWorktreeRemovalOffer(input: {
+  threads: ReadonlyArray<
+    Pick<ThreadShell, "id" | "worktreePath"> & {
+      settledOverride?: ThreadShell["settledOverride"];
+      archivedAt?: string | null;
+    }
+  >;
+  threadId: ThreadShell["id"];
+  projectCwd: string | null;
+}): WorktreeRemovalOffer | null {
+  // A thread that is itself settled or archived is done with the worktree and
+  // must not count as an occupant: otherwise the last thread to settle always
+  // sees the earlier ones still there, and a shared worktree is never offered.
+  const occupants = input.threads.filter(
+    (thread) =>
+      thread.id === input.threadId ||
+      ((thread.archivedAt ?? null) === null && thread.settledOverride !== "settled"),
+  );
+  const worktreePath = getOrphanedWorktreePathForThread(occupants, input.threadId);
+  if (!worktreePath || !input.projectCwd) {
+    return null;
+  }
+  return {
+    worktreePath,
+    projectCwd: input.projectCwd,
+    displayPath: formatWorktreePathForDisplay(worktreePath),
+  };
+}
