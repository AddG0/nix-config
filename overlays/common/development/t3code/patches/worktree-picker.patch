diff --git a/apps/web/src/worktreeCleanup.ts b/apps/web/src/worktreeCleanup.ts
index 109f71cc..272ac614 100644
--- a/apps/web/src/worktreeCleanup.ts
+++ b/apps/web/src/worktreeCleanup.ts
@@ -43,3 +43,34 @@ export function formatWorktreePathForDisplay(worktreePath: string): string {
   const lastPart = parts[parts.length - 1]?.trim() ?? "";
   return lastPart.length > 0 ? lastPart : trimmed;
 }
+
+export interface WorktreeRemovalOffer {
+  worktreePath: string;
+  projectCwd: string;
+  displayPath: string;
+}
+
+/** The worktree a thread leaves behind, or null when it has none or another live thread uses it. */
+export function resolveWorktreeRemovalOffer(input: {
+  threads: ReadonlyArray<
+    Pick<ThreadShell, "id" | "worktreePath" | "settledOverride" | "archivedAt">
+  >;
+  threadId: ThreadShell["id"];
+  projectCwd: string | null;
+}): WorktreeRemovalOffer | null {
+  // Settled and archived threads are done with it, or the last of several to settle is never offered.
+  const occupants = input.threads.filter(
+    (thread) =>
+      thread.id === input.threadId ||
+      (thread.archivedAt === null && thread.settledOverride !== "settled"),
+  );
+  const worktreePath = getOrphanedWorktreePathForThread(occupants, input.threadId);
+  if (!worktreePath || !input.projectCwd) {
+    return null;
+  }
+  return {
+    worktreePath,
+    projectCwd: input.projectCwd,
+    displayPath: formatWorktreePathForDisplay(worktreePath),
+  };
+}
