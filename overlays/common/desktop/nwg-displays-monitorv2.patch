new file mode 100644
index 0000000..3e8d961
--- /dev/null
+++ b/nwg_displays/monitorv2.py
@@ -0,0 +1,21 @@
+def monitorv2_blocks(lines):
+    """Rewrite monitor= lines as Hyprland monitorv2 blocks, which merge with declared blocks for the same output."""
+    out = []
+    for line in lines:
+        if not line.startswith("monitor="):
+            out.append(line)
+            continue
+        args = [a.strip() for a in line[len("monitor="):].split(",")]
+        out.append("monitorv2 {")
+        out.append(f"  output = {args[0]}")
+        if args[1] in ("disable", "disabled"):
+            out.append("  disabled = 1")
+        elif args[1] == "transform":
+            out.append(f"  transform = {args[2]}")
+        else:
+            if len(args) < 4 or len(args) % 2:
+                raise ValueError(f"monitor line has no value for its last key: {line}")
+            out.extend(["  disabled = 0", f"  mode = {args[1]}", f"  position = {args[2]}", f"  scale = {args[3]}"])
+            out.extend(f"  {k} = {v}" for k, v in zip(args[4::2], args[5::2]))
+        out.append("}")
+    return out
