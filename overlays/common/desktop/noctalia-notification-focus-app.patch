+            const std::string appId = n.desktopEntry.value_or(n.appName);
+            if (!appId.empty()) {
+              m_wayland->activateToplevelForAppId(appId);
+            }
+            break;
+          }
+        }
+      }
+      if (hasDefaultAction && m_notifications != nullptr) {
